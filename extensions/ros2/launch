#!/bin/bash

function source_with_prefix() {
    export ROS_WORKSPACE_CURRENT_PREFIX="$1"
    SETUP_SCRIPT="$ROS_WORKSPACE_CURRENT_PREFIX/local_setup.bash"
    if [ ! -f "$SETUP_SCRIPT" ]; then
      echo "error: $SETUP_SCRIPT not found"
      exit 1
    fi
    # shellcheck disable=SC1090,SC1091
    source "$SETUP_SCRIPT"
}

# Save off parameters, the sourced setup scripts may manipulate them.
original_args=("$@")

UNDERLAY_DISTRO="$SNAP/opt/ros/underlay_ws/opt/ros/$ROS_DISTRO"
UNDERLAY_SNAP_WS="$SNAP/opt/ros/underlay_ws/opt/ros/snap"

# Prepend merged-install library dirs first so dlopen finds core ROS libs (e.g.
# rclcpp) even if workspace setup scripts are picky about ordering.
if [ -d "$UNDERLAY_DISTRO/lib" ]; then
  export LD_LIBRARY_PATH="$UNDERLAY_DISTRO/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
if [ -d "$UNDERLAY_SNAP_WS/lib" ]; then
  export LD_LIBRARY_PATH="$UNDERLAY_SNAP_WS/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

if [ -f "$UNDERLAY_DISTRO/local_setup.bash" ]; then
  source_with_prefix "$UNDERLAY_DISTRO"
fi
if [ -f "$UNDERLAY_SNAP_WS/local_setup.bash" ]; then
  source_with_prefix "$UNDERLAY_SNAP_WS"
fi

if [ -f "$UNDERLAY_DISTRO/local_setup.bash" ] || [ -f "$UNDERLAY_SNAP_WS/local_setup.bash" ]; then

  case "$SNAP_ARCH" in
    "amd64") ARCH_TRIPLET='x86_64-linux-gnu'
    ;;
    "arm64") ARCH_TRIPLET="aarch64-linux-gnu"
    ;;
    "armhf") ARCH_TRIPLET="arm-linux-gnueabihf"
    ;;
    *)
      echo "Unsupported architecture '$SNAP_ARCH' for this app build."
      exit 1
    ;;
  esac

  export PATH="$SNAP/opt/ros/underlay_ws/usr/bin:$PATH"
  export LD_LIBRARY_PATH="$SNAP/opt/ros/underlay_ws/usr/lib:$SNAP/opt/ros/underlay_ws/usr/lib/$ARCH_TRIPLET:$LD_LIBRARY_PATH"
elif [ -d "$SNAP/opt/ros/underlay_ws" ] && [ ! -f "$UNDERLAY_DISTRO/local_setup.bash" ]; then
  echo "ros2-launch: content mount $SNAP/opt/ros/underlay_ws missing local_setup.bash for ROS_DISTRO=$ROS_DISTRO (is the content plug connected?)" >&2
fi

source_with_prefix "$SNAP/opt/ros/$ROS_DISTRO"

if [ -f "$SNAP/opt/ros/snap/local_setup.bash" ]; then
  source_with_prefix "$SNAP/opt/ros/snap"
fi

exec "${original_args[@]}"
